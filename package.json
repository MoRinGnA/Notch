{
  "name": "notch",
  "version": "1.0.0",
  "description": "Windows 상단 미디어·시스템 상태 노치 위젯",
  "author": "MoRinGnA",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "audio:build": "node scripts/build-audio.mjs",
    "build": "npm run audio:build && tsc --noEmit -p tsconfig.json && vite build && tsc -p electron/tsconfig.json && node -e \"require('fs').copyFileSync('electron/package.json','dist-electron/package.json')\"",
    "dist:win": "npm run build && electron-builder --win portable --x64 --publish never",
    "start": "electron .",
    "icon": "node scripts/make-icon.mjs"
  },
  "build": {
    "appId": "com.notch.app",
    "productName": "Notch",
    "directories": {
      "output": "release"
    },
    "icon": "assets/icon.ico",
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "native/audio/bin",
        "to": ".",
        "filter": [
          "notch-audio.exe"
        ]
      }
    ],
    "win": {
      "target": "portable",
      "artifactName": "Notch.exe",
      "signExecutable": false
    }
  },
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "dependencies": {
    "@fontsource/orbit": "5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
